<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.pip.server.auth.bean.RewardHistory" table="tbl_rewardhistory">
        <id name="id" type="int">
            <column name="id" />
            <generator class="identity"></generator>
        </id>
        <property name="userID" type="string">
            <column name="userid" not-null="true" />
        </property>
        <property name="cause" type="int">
            <column name="cause" not-null="true" />
        </property>
        <property name="sourceUser" type="string">
            <column name="sourceuser" not-null="true" />
        </property>
        <property name="accountID" type="int">
            <column name="accountid" not-null="true" />
        </property>
        <property name="playerID" type="int">
            <column name="playerid" not-null="true" />
        </property>
        <property name="level" type="int">
            <column name="level" not-null="true" />
        </property>
        <property name="rewardTime" type="timestamp">
            <column name="rewardtime" length="19" not-null="true" />
        </property>
        <property name="rewardMoney" type="int">
            <column name="rewardmoney" not-null="true" />
        </property>
    </class>
</hibernate-mapping>
