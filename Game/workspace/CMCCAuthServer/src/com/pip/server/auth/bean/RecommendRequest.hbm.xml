<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.pip.server.auth.bean.RecommendRequest" table="tbl_recommendrequest">
        <id name="id" type="int">
            <column name="id" />
            <generator class="identity"></generator>
        </id>
        <property name="userId" type="string">
            <column name="userid" not-null="true" />
        </property>
        <property name="accountId" type="int">
            <column name="accountid" not-null="true" />
        </property>
        <property name="serverId" type="string">
            <column name="serverid" not-null="true" />
        </property>
        <property name="playerId" type="int">
            <column name="playerid" not-null="true" />
        </property>
        <property name="targetPhone" type="string">
            <column name="targetphone" not-null="true" />
        </property>
        <property name="createTime" type="timestamp">
            <column name="createtime" length="19" not-null="true" />
        </property>
    </class>
</hibernate-mapping>
