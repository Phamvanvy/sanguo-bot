<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.pip.server.auth.bean.RecommendRecord" table="tbl_recommendrecord">
        <id name="id" type="int">
            <column name="id" />
            <generator class="identity"></generator>
        </id>
        <property name="source" type="string">
            <column name="source" not-null="true" />
        </property>
        <property name="sourceRegion" type="string">
            <column name="sourceregion" not-null="true" />
        </property>
        <property name="target" type="string">
            <column name="target" not-null="true" />
        </property>
        <property name="targetRegion" type="string">
            <column name="targetregion" not-null="true" />
        </property>
        <property name="finishTime" type="timestamp">
            <column name="finishtime" length="19" not-null="true" />
        </property>
    </class>
</hibernate-mapping>
