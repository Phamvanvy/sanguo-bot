<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="com.pip.itimes.server.bean.Blog" table="tbl_blog">
        <id name="id" type="int">
            <column name="id" />
            <generator class="identity"></generator>
        </id>
        <property name="playerId" type="int">
            <column name="playerid" not-null="true" />
        </property>
        <property name="playerName" type="string">
            <column name="playername" not-null="true" />
        </property>
        <property name="title" type="string">
            <column name="title" not-null="true" />
        </property>
        <property name="content" type="string">
            <column name="content" length="65535" />
        </property>
        <property name="createTime" type="timestamp">
            <column name="createtime" length="19" not-null="true" />
        </property>
        <property name="readedTimes" type="int">
            <column name="readedtimes" not-null="true" />
        </property>
    </class>
</hibernate-mapping>
