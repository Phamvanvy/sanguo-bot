    <target name="restart57">
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/servertest_tw/udata"/>
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/servertest_tw/kserver"/>
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/servertest_tw/startup_silent.sh"/>
    </target>
    
    <target name="deploy_symbian">
        <scp todir="lighthu@221.179.216.57:/home/lighthu/sango/serversymbiantest/lib" password="no&amp;2009@jive" trust="true" verbose="true">
            <fileset dir=".">
                <include name="editor.jar"/>
                <include name="workshop.jar"/>
                <include name="peony.jar"/>
            </fileset>
        </scp>
        <scp todir="lighthu@221.179.216.57:/home/lighthu/sango/serversymbiantest" password="no&amp;2009@jive" trust="true" verbose="true">
            <fileset dir=".">
                <include name="skill.jar"/>
            </fileset>
        </scp>
        <scp todir="lighthu@221.179.216.57:/home/lighthu/sango/serversymbiantest" password="no&amp;2009@jive" trust="true" verbose="true">
            <fileset dir=".">
                <include name="data.7z"/>
            </fileset>
        </scp>
    </target>
  
    <target name="restart_symbian">
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/serversymbiantest/udata"/>
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/serversymbiantest/kserver"/>
        <sshexec host="221.179.216.57" username="lighthu" password="no&amp;2009@jive" trust="true" command="/home/lighthu/sango/serversymbiantest/startup_silent.sh"/>
    </target>

    <target name="dist" depends="cleandist,distdb,distnet,distworkshop,disteditor,distserver,distskills,7z" />

    <target name="checkout">
        <antcall target="checkout-code" />
        <antcall target="checkout-data" />
    </target>
    
    <target name="checkout-code">
        <antcall target="cleancode" />
        <antcall target="server-check-out" />
        <antcall target="client-check-out" />  
        <antcall target="editor-check-out" />  
        <antcall target="db-check-out" />  
        <antcall target="net-check-out" />  
        <antcall target="workshop-check-out" />
    </target>
    
    <target name="checkout-data">
        <antcall target="cleandata" /> 
        <antcall target="data-check-out" />
    </target>
    
    <target name="build">
        <antcall target="checkout" />
        <antcall target="dist" /> 
    </target>
</project>