                <include name="editor.jar"/>
                <include name="workshop.jar"/>
                <include name="peony.jar"/>
            </fileset>
        </scp>
        <scp todir="lighthu@221.179.216.57:/home/lighthu/sango/servertest_tw" password="no&amp;2009@jive" trust="true" verbose="true">
            <fileset dir="${dist}">
                <include name="skill.jar"/>
            </fileset>
        </scp>
        <!--
        <scp todir="lighthu@221.179.216.57:/home/lighthu/sango/servertest_tw" password="no&amp;2009@jive" trust="true" verbose="true">
            <fileset dir=".">
                <include name="data.7z"/>
