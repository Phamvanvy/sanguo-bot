{
  "manifest_version": 3,
  "minimum_chrome_version": "118",
  "name": "Sanguo Flow Controller",
  "version": "0.4.2",
  "description": "Chạy các flow nhiệm vụ Sanguo từ panel nổi trong game.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://play.minhchauh5.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.minhchauh5.com/*"],
      "js": ["network_probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.minhchauh5.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ẩn/hiện Sanguo flows"
  }
}
